<?xml version='1.0' encoding='UTF-8' standalone='yes' ?>
<Robot type="FirstInspires-FTC">
    <LynxUsbDevice name="Control Hub Portal" serialNumber="(embedded)" parentModuleAddress="173">
        <ServoHub name="Servo Hub 3" port="3">
            <Servo name="intakeClaw" port="0" />
            <Servo name="intakeWrist" port="1" />
            <Servo name="intakeElbow" port="2"/>
            <Servo name="intakeShoulderRight" port="3"/>
            <Servo name="intakeShoulderLeft" port="4"/>
            <Servo name="intakeTurret" port="5"/>
        </ServoHub>
        <ServoHub name="Servo Hub 4" port="4">
            <Servo name="outtakeElbowRight" port="0" />
            <Servo name="intakeSlideLeft" port="1" />
            <Servo name="intakeSlideRight" port="2" />
            <Servo name="outtakeElbowLeft" port="3" />
            <Servo name="outtakeWrist" port="4" />

        </ServoHub>
        <LynxModule name="Expansion Hub 2" port="2">
            <goBILDA5202SeriesMotor name="leftFront" port="0" />
